.DS_Store
.env
# Written by install.sh when the installation is complete
.installed

# Pixelfed itself is its own repository, cloned into src/htdocs by install.sh
/src/
/mariadb/
# Database dumps written by update.sh
/backups/
docker-compose.override.yml
# Host nginx configuration generated by install.sh
nginx/*
!nginx/.gitkeep
