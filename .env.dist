###> general ###
# Name of this instance: prefix of the containers and the image (install.sh derives it
# from the domain, e.g. my-funny-domain.tld -> my-funny-domain-tld)
APP_NAME=pixelfed
# Public domain of the instance (localhost for local use)
APP_DOMAIN=localhost
TZ=Europe/Berlin
###< general ###

###> web server (PHP 8.5.12 + Apache) ###
# Port on the host: the instance is available at http://localhost:${APACHE_PORT}/
APACHE_PORT=8080
# Interface for that port: 127.0.0.1 behind a reverse proxy (nginx) or for local use,
# 0.0.0.0 to reach the container directly from other machines
APACHE_BIND=127.0.0.1
# Pixelfed's directory (checkout of PIXELFED_REPO), mounted into the containers:
#   locally  ./src/htdocs (a relative path needs the leading ./)
#   server   /var/www/htdocs/<domain> – belongs to www-data, outside this directory
APACHE_HTDOCS=./src/htdocs
###< web server ###

###> pixelfed (cloned into ${APACHE_HTDOCS} by install.sh) ###
PIXELFED_REPO=https://github.com/pixelfed/pixelfed.git
# latest = newest release (update.sh follows new releases), dev = development branch,
# or a fixed release tag such as v0.15.2
PIXELFED_VERSION=latest
###< pixelfed ###

###> database (MariaDB) ###
MARIADB_VERSION=12.3
MARIADB_LOCAL_DIR=./mariadb/data
MARIADB_DATA_DIR=/lib
MYSQL_DATABASE=pixelfed
MYSQL_USER=pixelfed
# install.sh generates random passwords when they are empty
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
###< database ###
